<h1>予定一覧</h1>

<p>
  <%= link_to '新規作成', new_schedule_path, class: 'btn-primary' %>
</p>


<p>
  予定の合計数：<strong><%= @schedules.count %></strong><br>
  本日：<strong><%= ymd(Date.current) %></strong>
</p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始</th>
      <th>終了</th>
      <th>終日</th>
      <th>更新日時</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= date_by_all_day(schedule.start_at, schedule.all_day) %></td>
        <td><%= date_by_all_day(schedule.end_at,   schedule.all_day) %></td>
        <td><%= maru(schedule.all_day) %></td>
        <td><%= ymdhm(schedule.updated_at) %></td>
        <td><%= link_to '詳細', schedule %></td>
        <td><%= link_to '編集', edit_schedule_path(schedule) %></td>
        <td><%= link_to '削除', schedule, method: :delete, data: { confirm: '予定を削除しますか？' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>


